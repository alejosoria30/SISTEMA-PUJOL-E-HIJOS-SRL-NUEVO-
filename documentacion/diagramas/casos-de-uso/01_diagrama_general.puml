@startuml 01_diagrama_general
title Sistema de Gestión Integral - Pujol e Hijos S.R.L. (Distribuidora Mayorista de Bebidas)
subtitle Diagrama General de Casos de Uso UML 2.x

skinparam backgroundColor #FFFFFF
skinparam handwritten false
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12

' Estilos de actores y casos de uso
skinparam actor {
    BackgroundColor #E1F5FE
    BorderColor #0288D1
    FontColor #01579B
}

skinparam usecase {
    BackgroundColor #F1F8E9
    BorderColor #558B2F
    FontColor #1B5E20
    ArrowColor #37474F
}

skinparam package {
    BackgroundColor #F5F5F5
    BorderColor #BDBDBD
    FontColor #212121
}

' Actores Humanos del Negocio
actor "Administrador" as Admin
actor "Empleado\n(Vendedor / Cajero)" as Empleado
actor "Cliente" as Cliente

' Sistemas Externos
actor "Google OAuth 2.0 API\n<<Sistema Externo>>" as GoogleAuth <<External>>

' Límite del Sistema
rectangle "Sistema Pujol e Hijos S.R.L." as SistemaPujol {

    ' Paquete Autenticación y Usuarios
    package "Módulo de Seguridad y Accesos" {
        usecase "Iniciar Sesión con Credenciales" as CU_Login
        usecase "Iniciar Sesión con Google" as CU_LoginGoogle
        usecase "Registrar Cuenta de Usuario" as CU_Registro
        usecase "Administrar Usuarios" as CU_AdminUsuarios
        usecase "Administrar Roles y Permisos" as CU_AdminRoles
    }

    ' Paquete Productos y Stock
    package "Módulo de Productos y Stock" {
        usecase "Consultar Catálogo de Bebidas" as CU_ConsultarCatalogo
        usecase "Gestionar Productos (Alta/Baja/Modificación)" as CU_GestionProductos
        usecase "Ajustar Precios Unitarios" as CU_AjustarPrecios
        usecase "Registrar Movimiento de Stock\n(Entrada/Salida/Ajuste)" as CU_RegistrarMovStock
        usecase "Actualizar Inventario Físico" as CU_ActualizarInv
    }

    ' Paquete Ventas
    package "Módulo de Ventas" {
        usecase "Registrar Venta de Bebidas" as CU_RegistrarVenta
        usecase "Aplicar Descuento VIP" as CU_DescuentoVIP
        usecase "Descontar Stock de Productos" as CU_DescontarStock
        usecase "Registrar Ingreso de Venta en Caja" as CU_IngresoVentaCaja
    }

    ' Paquete Caja y Rendición
    package "Módulo de Caja y Tesorería" {
        usecase "Abrir Turno de Caja" as CU_AbrirCaja
        usecase "Registrar Movimiento Extraordinario de Caja" as CU_MovCajaManual
        usecase "Cerrar Turno de Caja y Arqueo" as CU_CerrarCaja
        usecase "Auditar Diferencias de Caja" as CU_AuditarDiferencia
    }

    ' Paquete Comprobantes
    package "Módulo de Comprobantes Fiscales" {
        usecase "Emitir Comprobante (Factura A/B/C/Ticket)" as CU_EmitirComp
        usecase "Consultar Comprobantes Emitidos" as CU_ConsultarComp
        usecase "Imprimir Ticket / Factura" as CU_ImprimirComp
    }

    ' Paquete Historial y Reportes
    package "Módulo de Consultas y Reportes" {
        usecase "Consultar Historial de Ventas" as CU_HistorialVentas
        usecase "Generar Reporte de Recaudación por Medio de Pago" as CU_ReporteRecaudacion
    }
}

' Relaciones de Herencia / Especialización de Actores
Empleado -up-|> Cliente : "Generalización (Todo empleado es usuario registrado)"
Admin -up-|> Empleado : "Generalización (Hereda permisos operativos)"

' Asociaciones de Actores a Casos de Uso
Cliente --> CU_Login
Cliente --> CU_LoginGoogle
Cliente --> CU_Registro
Cliente --> CU_ConsultarCatalogo

Empleado --> CU_RegistrarVenta
Empleado --> CU_ConsultarCatalogo
Empleado --> CU_RegistrarMovStock
Empleado --> CU_AbrirCaja
Empleado --> CU_CerrarCaja
Empleado --> CU_MovCajaManual
Empleado --> CU_EmitirComp
Empleado --> CU_ConsultarComp
Empleado --> CU_HistorialVentas

Admin --> CU_GestionProductos
Admin --> CU_AjustarPrecios
Admin --> CU_AdminUsuarios
Admin --> CU_AdminRoles
Admin --> CU_AuditarDiferencia
Admin --> CU_ReporteRecaudacion

' Integración con Sistema Externo (Asociación estándar UML)
CU_LoginGoogle -- GoogleAuth

' Relaciones de Inclusión (<<include>>)
CU_RegistrarVenta .> CU_DescontarStock : "<<include>>"
CU_RegistrarVenta .> CU_IngresoVentaCaja : "<<include>>"
CU_RegistrarMovStock .> CU_ActualizarInv : "<<include>>"
CU_CerrarCaja .> CU_AuditarDiferencia : "<<include>>"

' Relaciones de Extensión (<<extend>>)
CU_DescuentoVIP .> CU_RegistrarVenta : "<<extend>>\n[Si cliente es VIP y tiene descuento configurado]"
CU_ImprimirComp .> CU_EmitirComp : "<<extend>>\n[A requerimiento de impresión]"

note right of GoogleAuth
  <b>Sistema Externo:</b>
  Google Identity Services / OAuth 2.0 API
  Valida identidad externa mediante token Bearer.
end note

note bottom of SistemaPujol
  <b>Aclaración de Arquitectura Técnica:</b>
  El sistema se compone de una SPA en Angular 16+ conectada mediante API REST
  a un backend en PHP Nativo (PDO + JWT en Front Controller api/index.php).
  Los frameworks y librerías son internos y no constituyen actores UML externos.
end note

@enduml
