@startuml 04_modulo_movimientos_stock
title Módulo de Movimientos de Stock - Pujol e Hijos S.R.L.
subtitle Diagrama de Casos de Uso UML 2.x

skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam shadowing false

skinparam actor {
    BackgroundColor #E1F5FE
    BorderColor #0288D1
    FontColor #01579B
}

skinparam usecase {
    BackgroundColor #F1F8E9
    BorderColor #558B2F
    FontColor #1B5E20
    ArrowColor #37474F
}

actor "Empleado\n(Encargado de Depósito / Ventas)" as Empleado
actor "Administrador" as Admin

Admin -up-|> Empleado : "Generalización"

rectangle "Subsistema de Movimientos de Stock" {
    usecase "Registrar Movimiento de Stock" as CU_RegistrarMov
    usecase "Registrar Entrada de Mercadería\n(Recepción de Packs Embotelladora)" as CU_Entrada
    usecase "Registrar Salida de Mercadería\n(Rotura / Merma / Vencimiento)" as CU_Salida
    usecase "Registrar Ajuste de Stock\n(Auditoría Física de Depósito)" as CU_Ajuste
    usecase "Actualizar Saldo en Inventario" as CU_ImpactarInventario
    usecase "Consultar Auditoría de Movimientos" as CU_ConsultarMovs
}

Empleado --> CU_RegistrarMov
Empleado --> CU_ConsultarMovs

' Generalización de tipos de movimiento
CU_Entrada -up-|> CU_RegistrarMov
CU_Salida -up-|> CU_RegistrarMov
CU_Ajuste -up-|> CU_RegistrarMov

' Inclusión obligatoria
CU_RegistrarMov .> CU_ImpactarInventario : "<<include>>"

note right of CU_RegistrarMov
  <b>Trazabilidad Técnica:</b>
  • <b>Frontend:</b> StockComponent (stock.component.ts) -> StateService.saveMovimientoStock()
  • <b>Ruta Backend:</b> POST /movimientos-stock
  • <b>Despachador:</b> api/index.php (Líneas 625-665)
  • <b>Tablas afectadas:</b> movimientos_stock, inventario
  • <b>Lógica transaccional:</b>
    - Entrada: stockActual = stockActual + cantidad
    - Salida: stockActual = stockActual - cantidad
    - Ajuste: stockActual = cantidad
end note

note bottom of CU_ConsultarMovs
  <b>Ruta de Consulta:</b> GET /movimientos-stock
  Provee trazabilidad: fecha, producto, tipo,
  cantidad, usuario responsable y observaciones.
end note

@enduml
